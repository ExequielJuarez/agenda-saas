# Copiá este archivo como .env y completá tus datos.
PORT=3000
NODE_ENV=development

# Base de datos MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=agendo

# Sesiones (poné un texto largo y aleatorio)
SESSION_SECRET=cambiar-este-secreto

# Contraseña de TU panel de dueño (/owner)
OWNER_PASSWORD=cambiar-esta-clave

# ---- Recordatorios automáticos por WhatsApp (opcional) ----
# Sin esto, los recordatorios funcionan igual con un toque desde el panel (WhatsApp Web).
# Para enviarlos solos hace falta una cuenta de WhatsApp Business Platform (Cloud API) de Meta
# y una plantilla aprobada. Ver README.
# WA_TOKEN=
# WA_PHONE_ID=
# WA_TEMPLATE=recordatorio_turno
# WA_LANG=es_AR
# Para probar sin enviar nada (solo escribe en la consola):
# WA_DRY_RUN=true
